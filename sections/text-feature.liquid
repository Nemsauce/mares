{%- comment -%}
  Reusable heading and paragraph on a bg-raised band. Used for the closing section of
  the home page. The heading and the paragraph (the header's subtitle) come from
  snippets/section-header.liquid. Defaults are t: keys in locales/es.default.schema.json
  (source: docs/content/catalogo-y-copy.md).
{%- endcomment -%}

{{ 'section-text-feature.css' | asset_url | stylesheet_tag }}

<section class="text-feature">
  <div class="container">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      heading_accent: section.settings.heading_accent,
      subtitle: section.settings.text,
      level: 2
    %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.text-feature.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.text-feature.settings.heading.label",
      "default": "t:sections.text-feature.settings.heading.default"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "t:sections.text-feature.settings.heading_accent.label",
      "info": "t:sections.text-feature.settings.heading_accent.info"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.text-feature.settings.eyebrow.label"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.text-feature.settings.text.label",
      "default": "t:sections.text-feature.settings.text.default"
    }
  ],
  "presets": [
    {
      "name": "t:sections.text-feature.presets.name"
    }
  ]
}
{% endschema %}
