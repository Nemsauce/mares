{%- comment -%}
  Reusable heading and paragraph on a bg-raised band. Used for the closing section of
  the home page. Defaults are t: keys in locales/es.default.schema.json
  (source: docs/content/catalogo-y-copy.md).
{%- endcomment -%}

{{ 'section-text-feature.css' | asset_url | stylesheet_tag }}

<section class="text-feature">
  <div class="container text-feature__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="text-feature__heading text-display-md">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="text-feature__text text-body-lg">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.text-feature.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.text-feature.settings.heading.label",
      "default": "t:sections.text-feature.settings.heading.default"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.text-feature.settings.text.label",
      "default": "t:sections.text-feature.settings.text.default"
    }
  ],
  "presets": [
    {
      "name": "t:sections.text-feature.presets.name"
    }
  ]
}
{% endschema %}
