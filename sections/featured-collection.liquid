{%- comment -%}
  Featured collection (docs/THEME_PLAN.md 6.7b): the shared section header, a row of
  product cards from the chosen collection, and an optional secondary link to the whole
  collection. The cards are snippets/product-card.liquid, unchanged.

  Layout:
    below 1024px  one horizontal row with scroll snap. The row bleeds to the screen edges
                  and the next card peeks in, so it reads as scrollable. Every card is a
                  link, so the keyboard reaches each one and the browser scrolls it in.
    from 1024px   a grid: 4 per row when there are 4 or more products, otherwise 3 per
                  row. Fewer products than columns are centered, so the row never ends in
                  an empty gap.
  The column count is written by Liquid as --fc-columns and --fc-count.

  The cards are below the fold on the home page, so every image is lazy: nothing here
  competes with the hero image for the LCP.

  data-reveal: the content rises in once, when it scrolls into view (assets/reveal.js).
  Without the script it is simply shown.

  Tabs by product type (show_tabs, off by default): a row of filter chips above the cards.
  A chip shows the products of one type (the first max_products of it); "Todas" shows the
  first max_products of the collection. It is a set of toggle buttons (aria-pressed), not an
  ARIA tabs widget: there is one list, not one panel per tab, and native buttons already work
  with Tab, Enter and Space. No page reload; assets/featured-tabs.js hides and shows the cards
  and announces how many are shown.
  So that a type has products to show, tabs read up to 24 products of the collection, not
  just max_products. A type comes from product.type; products without one only appear under
  "Todas". With fewer than two types there is nothing to filter and no chips render.

  Without JavaScript (chosen on purpose): the chips are rendered hidden and the script shows
  them, so they are absent, never buttons that do nothing, and every one of the (up to 24)
  products renders. The alternatives were chips that link to a filtered collection URL (a page
  load, and a filter the collection page does not have yet) and hiding all but max_products
  on the server (then a type's products would be unreachable without the script).

  Nothing renders when the collection is missing or empty, except in the theme editor,
  where a short note says why the section is blank.

  General page: bg, bg-raised, ink, brand. No line colors and no line tags by default
  (one line per page, plan Q-5).
{%- endcomment -%}

{%- liquid
  assign fc_collection = section.settings.collection
  assign fc_limit = section.settings.max_products
  assign fc_count = 0
  if fc_collection != blank
    assign fc_count = fc_collection.products_count
    if fc_count > fc_limit
      assign fc_count = fc_limit
    endif
  endif

  assign fc_columns = 3
  if fc_count >= 4
    assign fc_columns = 4
  endif
  assign fc_shown = fc_count
  if fc_shown > fc_columns
    assign fc_shown = fc_columns
  endif

  # Tabs by type. The types are collected from up to 24 products, in the order they first
  # appear, as parallel arrays of handles (the data-type value) and labels (the chip text).
  assign fc_pool = fc_limit
  assign fc_use_tabs = false
  assign fc_type_keys = '' | split: ','
  assign fc_type_labels = '' | split: ','
  if section.settings.show_tabs and fc_collection != blank
    for product in fc_collection.products limit: 24
      assign type_key = product.type | handleize
      if type_key != blank
        unless fc_type_keys contains type_key
          assign one_key = type_key | split: ','
          assign one_label = product.type | strip | split: '|||'
          assign fc_type_keys = fc_type_keys | concat: one_key
          assign fc_type_labels = fc_type_labels | concat: one_label
        endunless
      endif
    endfor
    if fc_type_keys.size > 1
      assign fc_use_tabs = true
      assign fc_pool = 24
      assign fc_count = fc_collection.products_count
      if fc_count > fc_pool
        assign fc_count = fc_pool
      endif
      assign fc_columns = 3
      if fc_count >= 4
        assign fc_columns = 4
      endif
      assign fc_shown = fc_count
      if fc_shown > fc_columns
        assign fc_shown = fc_columns
      endif
    endif
  endif

  assign fc_link = section.settings.link
  if fc_link == blank and fc_collection != blank
    assign fc_link = fc_collection.url
  endif

  # Card width: about 2/3 of the screen below 600px, 2/5 to 1023px, 1/4 or 1/3 of the
  # 1200px content from 1024px.
  if fc_columns == 4
    assign fc_sizes = '(min-width: 1024px) 282px, (min-width: 600px) 40vw, 66vw'
  else
    assign fc_sizes = '(min-width: 1024px) 384px, (min-width: 600px) 40vw, 66vw'
  endif
-%}

{%- if fc_count > 0 -%}
  {{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}
  {%- if section.settings.show_divider -%}
    {{ 'section-divider.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- if fc_use_tabs -%}
    {{ 'component-chip.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'featured-tabs.js' | asset_url }}" defer></script>
  {%- endif -%}
  <script src="{{ 'reveal.js' | asset_url }}" defer></script>

  <section class="featured-collection{% if section.settings.show_divider %} section--divided{% endif %}">
    {%- if section.settings.show_divider -%}
      <div class="container section-divider" aria-hidden="true">{% render 'embroidery-divider' %}</div>
    {%- endif -%}
    <div class="container" data-reveal>
      {% render 'section-header',
        motif: section.settings.motif,
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        heading_accent: section.settings.heading_accent,
        subtitle: section.settings.subtitle,
        level: 2,
        class: 'featured-collection__header'
      %}

      {%- if fc_use_tabs -%}
        <featured-tabs
          class="featured-collection__tabbed"
          data-limit="{{ fc_limit }}"
          data-columns="{{ fc_columns }}"
          data-text-one="{{ 'featured_collection.tabs_result.one' | t: count: '[count]' }}"
          data-text-other="{{ 'featured_collection.tabs_result.other' | t: count: '[count]' }}"
        >
          <div
            class="featured-collection__tabs"
            role="group"
            aria-label="{{ 'featured_collection.tabs_label' | t }}"
            data-tabs
            hidden
          >
            <button type="button" class="chip" data-tab="all" aria-pressed="true">{{ 'featured_collection.tabs_all' | t }}</button>
            {%- for type_key in fc_type_keys -%}
              <button type="button" class="chip" data-tab="{{ type_key }}" aria-pressed="false">{{ fc_type_labels[forloop.index0] }}</button>
            {%- endfor -%}
          </div>
      {%- endif -%}

      <ul
        class="featured-collection__list"
        role="list"
        style="--fc-columns: {{ fc_columns }}; --fc-count: {{ fc_shown }};"
        {% if fc_use_tabs %}data-tabs-list{% endif %}
      >
        {%- for product in fc_collection.products limit: fc_pool -%}
          <li class="featured-collection__item"{% if fc_use_tabs %} data-type="{{ product.type | handleize }}"{% endif %}>
            {% render 'product-card',
              product: product,
              sizes: fc_sizes,
              eager: false,
              show_tag: section.settings.show_tag,
              heading_tag: 'h3'
            %}
          </li>
        {%- endfor -%}
      </ul>

      {%- if fc_use_tabs -%}
        </featured-tabs>
      {%- endif -%}

      {%- if section.settings.link_label != blank and fc_link != blank -%}
        <div class="featured-collection__footer">
          {% render 'button', label: section.settings.link_label, url: fc_link, variant: 'secondary' %}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="featured-collection">
    <div class="container">
      <p class="text-body">{{ 'featured_collection.empty_editor' | t }}</p>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "settings": [
    {
      "type": "select",
      "id": "motif",
      "label": "t:sections.shared.motif.label",
      "info": "t:sections.shared.motif.info",
      "options": [
        { "value": "none", "label": "t:sections.shared.motif.options__1.label" },
        { "value": "ola-suave", "label": "t:sections.shared.motif.options__2.label" },
        { "value": "luna-sobre-el-mar", "label": "t:sections.shared.motif.options__3.label" },
        { "value": "conchitas-nacaradas", "label": "t:sections.shared.motif.options__4.label" },
        { "value": "estrella-de-mar", "label": "t:sections.shared.motif.options__5.label" },
        { "value": "caballito-de-mar", "label": "t:sections.shared.motif.options__6.label" },
        { "value": "palmita", "label": "t:sections.shared.motif.options__7.label" },
        { "value": "sol", "label": "t:sections.shared.motif.options__8.label" }
      ],
      "default": "luna-sobre-el-mar"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:sections.shared.show_divider.label",
      "info": "t:sections.shared.show_divider.info",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.featured-collection.settings.eyebrow.label",
      "default": "t:sections.featured-collection.settings.eyebrow.default"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured-collection.settings.heading.label",
      "default": "t:sections.featured-collection.settings.heading.default"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "t:sections.featured-collection.settings.heading_accent.label",
      "info": "t:sections.featured-collection.settings.heading_accent.info",
      "default": "t:sections.featured-collection.settings.heading_accent.default"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:sections.featured-collection.settings.subtitle.label"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.settings.collection.label",
      "info": "t:sections.featured-collection.settings.collection.info"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:sections.featured-collection.settings.max_products.label",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_tabs",
      "label": "t:sections.featured-collection.settings.show_tabs.label",
      "info": "t:sections.featured-collection.settings.show_tabs.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_tag",
      "label": "t:sections.featured-collection.settings.show_tag.label",
      "info": "t:sections.featured-collection.settings.show_tag.info",
      "default": false
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.featured-collection.settings.link_label.label",
      "info": "t:sections.featured-collection.settings.link_label.info",
      "default": "t:sections.featured-collection.settings.link_label.default"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.featured-collection.settings.link.label",
      "info": "t:sections.featured-collection.settings.link.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-collection.name"
    }
  ]
}
{% endschema %}
