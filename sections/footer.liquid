{%- comment -%}
  Footer (docs/BUILD.md 6.2).
  PROPOSAL (the docs only say "pie de página" in body-sm): bg background, 1px line
  above, blocks in the 4/8/12 grid (1 per row below 600px, 2 per row to 1023px, 4 per
  row from 1024px), then a row with the copyright.
  No payment icons: the payment gateway is undecided.

  Link groups: built in, so the footer is useful before anyone adds a block, and a fresh
  install looks the same as this store (the footer group file lists brand and newsletter,
  and sets the FAQ page; returns and care come from config/settings_data.json).
  They sit right after the brand block, in this order (copy: docs/BRAND.md):
    Tienda      the two line collections and all products. A collection that does not
                exist, or is not on the online store, is skipped.
    Ayuda       preguntas frecuentes (section setting), cambios and cuidado de la prenda
                (theme settings page_returns and page_care). A page that is not set is
                skipped.
    Escríbenos  the social links that are set.
  A group with no links is not rendered at all, heading included, so there is never a
  dead link or a heading over nothing.
{%- endcomment -%}

{{ 'section-footer.css' | asset_url | stylesheet_tag }}

{%- assign brand_name = 'general.brand_name' | t -%}
{%- assign current_year = 'now' | date: '%Y' -%}

{%- assign store_descanso = collections['descanso'] -%}
{%- assign store_dia = collections['dia'] -%}

{%- capture store_links -%}
  {%- if store_descanso != blank -%}
    <li><a class="footer__link text-body-sm" href="{{ store_descanso.url }}">{{ 'footer.store.line_descanso' | t }}</a></li>
  {%- endif -%}
  {%- if store_dia != blank -%}
    <li><a class="footer__link text-body-sm" href="{{ store_dia.url }}">{{ 'footer.store.line_dia' | t }}</a></li>
  {%- endif -%}
  <li><a class="footer__link text-body-sm" href="{{ routes.all_products_collection_url }}">{{ 'footer.store.all_products' | t }}</a></li>
{%- endcapture -%}

{%- capture help_links -%}
  {%- if section.settings.page_faq != blank -%}
    <li><a class="footer__link text-body-sm" href="{{ section.settings.page_faq.url }}">{{ 'footer.help.faq' | t }}</a></li>
  {%- endif -%}
  {%- if settings.page_returns != blank -%}
    <li><a class="footer__link text-body-sm" href="{{ settings.page_returns.url }}">{{ 'footer.help.returns' | t }}</a></li>
  {%- endif -%}
  {%- if settings.page_care != blank -%}
    <li><a class="footer__link text-body-sm" href="{{ settings.page_care.url }}">{{ 'footer.help.care' | t }}</a></li>
  {%- endif -%}
{%- endcapture -%}

{%- capture social_links -%}
  {%- if settings.social_instagram_url != blank -%}
    <li><a class="footer__link text-body-sm" href="{{ settings.social_instagram_url }}">{{ 'general.social.instagram' | t }}</a></li>
  {%- endif -%}
  {%- if settings.social_tiktok_url != blank -%}
    <li><a class="footer__link text-body-sm" href="{{ settings.social_tiktok_url }}">{{ 'general.social.tiktok' | t }}</a></li>
  {%- endif -%}
  {%- if settings.social_facebook_url != blank -%}
    <li><a class="footer__link text-body-sm" href="{{ settings.social_facebook_url }}">{{ 'general.social.facebook' | t }}</a></li>
  {%- endif -%}
{%- endcapture -%}

{%- capture link_groups -%}
  {%- if store_links != blank -%}
    <div class="footer__block">
      <h2 class="footer__heading text-display-sm" id="footer-store-{{ section.id }}">{{ 'footer.store.heading' | t }}</h2>
      <nav aria-labelledby="footer-store-{{ section.id }}">
        <ul class="footer__links" role="list">{{ store_links }}</ul>
      </nav>
    </div>
  {%- endif -%}
  {%- if help_links != blank -%}
    <div class="footer__block">
      <h2 class="footer__heading text-display-sm" id="footer-help-{{ section.id }}">{{ 'footer.help.heading' | t }}</h2>
      <nav aria-labelledby="footer-help-{{ section.id }}">
        <ul class="footer__links" role="list">{{ help_links }}</ul>
      </nav>
    </div>
  {%- endif -%}
  {%- if social_links != blank -%}
    <div class="footer__block">
      <h2 class="footer__heading text-display-sm" id="footer-contact-{{ section.id }}">{{ 'footer.contact.heading' | t }}</h2>
      <ul class="footer__links" role="list" aria-labelledby="footer-contact-{{ section.id }}">{{ social_links }}</ul>
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- assign link_groups_shown = false -%}

<footer class="footer">
  <div class="container">
    {%- if section.blocks.size > 0 or link_groups != blank -%}
      <div class="grid footer__blocks">
        {%- for block in section.blocks -%}
          <div class="footer__block" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading text-display-sm" id="footer-heading-{{ block.id }}">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.menu.links.size > 0 -%}
                  <nav
                    {% if block.settings.heading != blank -%}
                      aria-labelledby="footer-heading-{{ block.id }}"
                    {%- else -%}
                      aria-label="{{ 'general.menu' | t }}"
                    {%- endif %}
                  >
                    <ul class="footer__links" role="list">
                      {%- for link in block.settings.menu.links -%}
                        <li><a class="footer__link text-body-sm" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  </nav>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading text-display-sm">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer__text text-body-sm">{{ block.settings.text }}</div>
                {%- endif -%}

              {%- when 'brand' -%}
                {%- comment -%}
                  PROVISIONAL line: the brand's working phrase from docs/BRAND.md (locale key
                  general.brand_tagline), shown until the merchant types their own.
                {%- endcomment -%}
                {%- liquid
                  assign brand_line = block.settings.text
                  if brand_line == blank
                    assign brand_line = 'general.brand_tagline' | t
                  endif
                -%}
                <p class="footer__wordmark text-display-md">{{ brand_name }}</p>
                <p class="footer__text text-body-sm">{{ brand_line }}</p>

              {%- when 'newsletter' -%}
                {%- comment -%}
                  Newsletter: Shopify's own customer form, so the address lands in the
                  store's customer list with email marketing accepted (no third party).
                  The page reloads and comes back to this form (its id is the anchor), so
                  the three states are decided here from the form object:
                    empty   no result yet: a hint under the field.
                    success form.posted_successfully?: a message replaces the field.
                    error   form.errors: the field gets aria-invalid (2px error border) and
                            a message in text, which the field styles in the error color.
                  The button is secondary: the page's one primary button belongs to the page.
                {%- endcomment -%}
                {{ 'component-field.css' | asset_url | stylesheet_tag }}
                {%- liquid
                  assign newsletter_form_id = 'newsletter-' | append: block.id
                  assign newsletter_input_id = newsletter_form_id | append: '-email'
                  assign newsletter_message_id = newsletter_form_id | append: '-message'
                  assign newsletter_submit_label = 'newsletter.submit' | t
                -%}

                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading text-display-sm">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="footer__text footer__newsletter-intro text-body-sm">{{ block.settings.text }}</p>
                {%- endif -%}

                {%- form 'customer', id: newsletter_form_id, class: 'footer__newsletter' -%}
                  {%- if form.posted_successfully? -%}
                    <p class="footer__newsletter-status text-body-sm" role="status" tabindex="-1">
                      {% render 'icon', name: 'check', size: 16 %}
                      <span>{{ 'newsletter.success' | t }}</span>
                    </p>
                  {%- else -%}
                    <input type="hidden" name="contact[tags]" value="newsletter">
                    <div class="field">
                      <label class="field__label" for="{{ newsletter_input_id }}">{{ 'newsletter.label' | t }}</label>
                      <input
                        class="field__input"
                        type="email"
                        id="{{ newsletter_input_id }}"
                        name="contact[email]"
                        value="{{ form.email | escape }}"
                        autocomplete="email"
                        required
                        aria-describedby="{{ newsletter_message_id }}"
                        {% if form.errors %}aria-invalid="true"{% endif %}
                      >
                      {%- if form.errors -%}
                        <p class="field__message" id="{{ newsletter_message_id }}" role="alert">{{ 'newsletter.error' | t }}</p>
                      {%- else -%}
                        <p class="field__message" id="{{ newsletter_message_id }}">{{ 'newsletter.hint' | t }}</p>
                      {%- endif -%}
                    </div>
                    {% render 'button', label: newsletter_submit_label, type: 'submit', variant: 'secondary' %}
                  {%- endif -%}
                {%- endform -%}
            {%- endcase -%}
          </div>
          {%- if block.type == 'brand' and link_groups_shown == false -%}
            {{ link_groups }}
            {%- assign link_groups_shown = true -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if link_groups_shown == false -%}
          {{ link_groups }}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_copyright -%}
      <div class="footer__legal footer__legal--divided">
        <p class="footer__copyright text-body-sm">{{ 'general.copyright' | t: year: current_year, shop_name: shop.name }}</p>
      </div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "page",
      "id": "page_faq",
      "label": "t:sections.footer.settings.page_faq.label",
      "info": "t:sections.footer.settings.page_faq.info"
    },
    {
      "type": "checkbox",
      "id": "show_copyright",
      "label": "t:sections.footer.settings.show_copyright.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.menu.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.menu.settings.menu.label",
          "info": "t:sections.footer.blocks.menu.settings.menu.info",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "brand",
      "name": "t:sections.footer.blocks.brand.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.footer.blocks.brand.settings.text.label",
          "info": "t:sections.footer.blocks.brand.settings.text.info"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.newsletter.settings.heading.label",
          "default": "t:sections.footer.blocks.newsletter.settings.heading.default"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.footer.blocks.newsletter.settings.text.label",
          "info": "t:sections.footer.blocks.newsletter.settings.text.info",
          "default": "t:sections.footer.blocks.newsletter.settings.text.default"
        }
      ]
    }
  ]
}
{% endschema %}
