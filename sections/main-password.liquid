{%- comment -%}
  Password page content: the wordmark, one line of text, the Shopify password form and
  the store owner's login link. The wordmark is the page's only heading (the password
  layout has no header), so it is the h1.
{%- endcomment -%}

{{ 'section-page.css' | asset_url | stylesheet_tag }}
{{ 'component-field.css' | asset_url | stylesheet_tag }}

{%- assign submit_label = 'password.submit' | t -%}

<div class="password">
  <div class="password__panel">
    <h1 class="password__brand text-display-lg">{{ 'general.brand_name' | t }}</h1>
    <p class="password__line text-body-lg">{{ 'general.brand_tagline' | t }}</p>

    {% form 'storefront_password', class: 'password__form' %}
      <div class="field">
        <label class="field__label" for="password-input">{{ 'password.label' | t }}</label>
        <input
          class="field__input"
          type="password"
          name="password"
          id="password-input"
          autocomplete="current-password"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="password-error"
          {% endif %}
        >
        {%- if form.errors -%}
          {%- comment -%} The error is text under the field, with the error token, never color alone. {%- endcomment -%}
          <div class="field__message" id="password-error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
      </div>
      {% render 'button', label: submit_label, type: 'submit' %}
    {% endform %}

    <a class="password__admin-link text-body-sm" href="/admin">{{ 'password.admin_link' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-password.name"
}
{% endschema %}
