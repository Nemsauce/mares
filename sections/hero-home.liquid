{%- comment -%}
  Home hero: headline, one line of text and the page's single primary button, then an
  optional row of up to three short trust notes (blocks, none by default).
  All copy comes from the section settings, whose defaults are the t: keys in
  locales/es.default.schema.json (source: docs/BRAND.md). The trust
  notes have no default text: the brand has not confirmed what it can claim.

  The heading is the h1 of the home page, because the headline is what the page is about.
  The header logo is never a heading (see sections/header.liquid), so this is the only h1.

  Two looks, one markup for the copy:
    - No image: type only, centered, on bg. Exactly the hero this section always had.
    - With an image: full bleed, the photograph behind the text. The text sits on a panel
      (see section-hero-home.css for how contrast is guaranteed with any photograph).

  The image is decorative (alt=""): everything it could say is in the text. It is the
  largest element on the page, so it is eager with fetchpriority high, has explicit
  width and height (image_tag writes them) and sits in an absolutely positioned layer, so
  its loading cannot move the layout. sizes is 100vw because it spans the viewport.

  Crop: the box is taller than 16:9 on phones, so a wide photograph is cropped hard.
  Two things keep that deliberate. The focal point set on the image in the editor becomes
  object-position (--hero-focal, and --hero-focal-wide for the wide image), so the crop
  keeps the subject. And an optional second, portrait image is served below 600px through
  <picture>, so a phone can get a photograph composed for it instead of a crop.

  General page: bg, bg-raised, ink, brand. No line colors.
{%- endcomment -%}

{{ 'section-hero-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image = section.settings.image
  assign hero_image_mobile = section.settings.image_mobile
  assign hero_classes = 'hero-home'
  if hero_image != blank
    assign hero_classes = hero_classes | append: ' hero-home--image'
    assign focal_wide = hero_image.presentation.focal_point | default: '50% 50%'
    assign focal_mobile = focal_wide
    if hero_image_mobile != blank
      assign focal_mobile = hero_image_mobile.presentation.focal_point | default: '50% 50%'
    endif
    assign focal_style = '--hero-focal: ' | append: focal_mobile | append: '; --hero-focal-wide: ' | append: focal_wide
  endif
-%}

{%- capture hero_notes -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.text != blank -%}
      <li class="hero-home__note text-body-sm" {{ block.shopify_attributes }}>
        {% render 'icon', name: 'check', size: 16 %}
        <span>{{ block.settings.text }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture hero_content -%}
  {%- if section.settings.heading != blank -%}
    <h1 class="hero-home__heading text-display-lg">{{ section.settings.heading }}</h1>
  {%- endif -%}

  {%- if section.settings.text != blank -%}
    <p class="hero-home__text text-body-lg">{{ section.settings.text }}</p>
  {%- endif -%}

  {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
    {% render 'button', label: section.settings.button_label, url: section.settings.button_link %}
  {%- endif -%}

  {%- if hero_notes != blank -%}
    <ul class="hero-home__notes" role="list">{{ hero_notes }}</ul>
  {%- endif -%}
{%- endcapture -%}

<section class="{{ hero_classes }}"{% if hero_image != blank %} style="{{ focal_style }}"{% endif %}>
  {%- if hero_image != blank -%}
    <div class="hero-home__background">
      {%- if hero_image_mobile != blank -%}
        {%- comment -%}
          Portrait image below 600px, wide image from 600px. The <img> carries the portrait
          one; the <source> replaces it from 600px. Only the widths the file can serve are
          listed, so a small upload never gets a srcset that promises more than it has.
        {%- endcomment -%}
        {%- capture wide_srcset -%}
          {%- assign wide_widths = '750,1100,1500,2000' | split: ',' -%}
          {%- for wide_width in wide_widths -%}
            {%- assign wide_width_number = wide_width | plus: 0 -%}
            {%- if wide_width_number <= hero_image.width -%}
              {{ hero_image | image_url: width: wide_width_number }} {{ wide_width_number }}w,
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- assign wide_srcset = wide_srcset | strip | remove_last: ',' -%}

        <picture>
          {%- if wide_srcset != blank -%}
            <source media="(min-width: 600px)" srcset="{{ wide_srcset }}" sizes="100vw">
          {%- endif -%}
          {{
            hero_image_mobile
            | image_url: width: 900
            | image_tag:
              widths: '450, 750, 900',
              sizes: '100vw',
              alt: '',
              class: 'hero-home__image',
              loading: 'eager',
              fetchpriority: 'high'
          }}
        </picture>
      {%- else -%}
        {{
          hero_image
          | image_url: width: 2000
          | image_tag:
            widths: '750, 1100, 1500, 2000',
            sizes: '100vw',
            alt: '',
            class: 'hero-home__image',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="container hero-home__inner">
    {%- if hero_image != blank -%}
      <div class="hero-home__panel">{{ hero_content }}</div>
    {%- else -%}
      {{ hero_content }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.hero-home.name",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero-home.settings.heading.label",
      "default": "t:sections.hero-home.settings.heading.default"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.hero-home.settings.text.label",
      "default": "t:sections.hero-home.settings.text.default"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero-home.settings.button_label.label",
      "default": "t:sections.hero-home.settings.button_label.default"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero-home.settings.button_link.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero-home.settings.image.label",
      "info": "t:sections.hero-home.settings.image.info"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.hero-home.settings.image_mobile.label",
      "info": "t:sections.hero-home.settings.image_mobile.info"
    }
  ],
  "blocks": [
    {
      "type": "trust_note",
      "name": "t:sections.hero-home.blocks.trust_note.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.hero-home.blocks.trust_note.settings.text.label",
          "info": "t:sections.hero-home.blocks.trust_note.settings.text.info"
        }
      ]
    }
  ]
}
{% endschema %}
