{%- comment -%}
  Essence of the brand on the home page: the shared section header (left aligned) and a
  paragraph, up to three short features (icon, title, optional one line), and a large image
  on the other side.

  Stacked below 1024px; two columns from 1024px. The image is second in the DOM, so the
  text is read first in every layout. Without an image the text takes the full width.

  Defaults for the heading and the paragraph are the closing copy of
  docs/content/catalogo-y-copy.md ("Por qué bordamos a mano"), verbatim, through t: keys in
  locales/es.default.schema.json. The features have no default text: the content file has
  none, and the brand has not confirmed what it can claim.

  General page: bg, bg-raised, ink, brand. No line colors.
{%- endcomment -%}

{{ 'section-essence.css' | asset_url | stylesheet_tag }}

{%- capture features -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.title != blank -%}
      <li class="essence__feature" {{ block.shopify_attributes }}>
        <span class="essence__icon">{% render 'icon', name: block.settings.icon %}</span>
        <div class="essence__feature-body">
          <h3 class="essence__feature-title text-display-sm">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="essence__feature-text text-body">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<section class="essence{% if section.settings.image != blank %} essence--image{% endif %}">
  <div class="container">
    <div class="grid essence__grid">
      <div class="essence__body">
        {% render 'section-header',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          heading_accent: section.settings.heading_accent,
          level: 2,
          align: 'left'
        %}

        {%- if section.settings.text != blank -%}
          <p class="essence__text text-body-lg">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- if features != blank -%}
          <ul class="essence__features" role="list">{{ features }}</ul>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        <div class="essence__media">
          {% render 'image',
            image: section.settings.image,
            alt: section.settings.image.alt,
            sizes: '(min-width: 1024px) min(50vw, 576px), 100vw',
            widths: '400, 600, 800, 1200',
            aspect_ratio: '4 / 5'
          %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.essence.name",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.essence.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.essence.settings.heading.label",
      "default": "t:sections.essence.settings.heading.default"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "t:sections.essence.settings.heading_accent.label",
      "info": "t:sections.essence.settings.heading_accent.info"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.essence.settings.text.label",
      "default": "t:sections.essence.settings.text.default"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.essence.settings.image.label",
      "info": "t:sections.essence.settings.image.info"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.essence.blocks.feature.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.essence.blocks.feature.settings.icon.label",
          "options": [
            {
              "value": "check",
              "label": "t:sections.essence.blocks.feature.settings.icon.options__1.label"
            },
            {
              "value": "plus",
              "label": "t:sections.essence.blocks.feature.settings.icon.options__2.label"
            },
            {
              "value": "search",
              "label": "t:sections.essence.blocks.feature.settings.icon.options__3.label"
            },
            {
              "value": "cart",
              "label": "t:sections.essence.blocks.feature.settings.icon.options__4.label"
            },
            {
              "value": "spool",
              "label": "t:sections.essence.blocks.feature.settings.icon.options__5.label"
            },
            {
              "value": "feather",
              "label": "t:sections.essence.blocks.feature.settings.icon.options__6.label"
            },
            {
              "value": "tag",
              "label": "t:sections.essence.blocks.feature.settings.icon.options__7.label"
            }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.essence.blocks.feature.settings.title.label",
          "info": "t:sections.essence.blocks.feature.settings.title.info"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.essence.blocks.feature.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.essence.name"
    }
  ]
}
{% endschema %}
