{%- capture icon_paths -%}
  {%- case name -%}
    {%- when 'cart' -%}
      <circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
    {%- when 'menu' -%}
      <path d="M4 12h16"/><path d="M4 18h16"/><path d="M4 6h16"/>
    {%- when 'close' -%}
      <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
    {%- when 'chevron-left' -%}
      <path d="m15 18-6-6 6-6"/>
    {%- when 'chevron-right' -%}
      <path d="m9 18 6-6-6-6"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'plus' -%}
      <path d="M5 12h14"/><path d="M12 5v14"/>
    {%- when 'check' -%}
      <path d="M20 6 9 17l-5-5"/>
  {%- endcase -%}
{%- endcapture -%}

{%- if icon_paths != blank -%}
  {{ 'component-icon.css' | asset_url | stylesheet_tag }}
  {%- assign icon_size = size | default: 24 -%}
  <svg
    class="icon icon--{{ name }}"
    xmlns="http://www.w3.org/2000/svg"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    {% if label != blank -%}
      role="img"
    {%- else -%}
      aria-hidden="true"
      focusable="false"
    {%- endif %}
  >
    {%- if label != blank -%}
      <title>{{ label | escape }}</title>
    {%- endif -%}
    {{ icon_paths }}
  </svg>
{%- endif -%}
