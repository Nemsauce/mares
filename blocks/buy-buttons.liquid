{%- comment -%}
  Add to cart: a Shopify product form that posts to the cart and then goes to the cart
  page (full page load, no script). The page's single primary button.

  The hidden id is the selected variant (product.selected_or_first_available_variant), so
  the variant chosen with the picker, or the only variant of a single-variant product,
  is what reaches the cart. The quantity input in blocks/quantity.liquid joins this form
  through the form attribute and the shared id.

  When the variant is sold out the button is disabled and a text message says why. No
  dynamic checkout button: the payment gateway is undecided.

  JavaScript hooks: [data-variant-region] marks this block for assets/variant-picker.js,
  which replaces it with the server-rendered version for the chosen variant.
  <product-form> (assets/product-form.js) adds to the cart without a page load and reads
  its messages from the data-*-text attributes. [data-form-error] is the error text it
  fills next to the button; it stays hidden and empty without the script.
  The color comes from the error token inline, because this commit may not touch CSS.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign form_id = 'product-form-' | append: product.id -%}
{%- assign add_label = 'products.add_to_cart' | t -%}
{%- assign unavailable = true -%}
{%- if current_variant.available -%}
  {%- assign unavailable = false -%}
{%- endif -%}

<div class="product-buy" data-variant-region="buy" {{ block.shopify_attributes }}>
  <product-form
    data-added-text="{{ 'products.added' | t }}"
    data-stock-error-text="{{ 'products.stock_error' | t }}"
    data-error-text="{{ 'products.add_error' | t }}"
    data-loading-text="{{ 'accessibility.loading' | t }}"
  >
    {%- form 'product', product, id: form_id, class: 'product-buy__form' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}">
      {% render 'button', label: add_label, type: 'submit', disabled: unavailable %}
      {%- if unavailable -%}
        <p class="product-buy__reason text-body-sm">{{ 'products.sold_out' | t }}</p>
      {%- endif -%}
      <p
        id="{{ form_id }}-error"
        class="text-body-sm"
        style="color: var(--color-error);"
        data-form-error
        hidden
      ></p>
    {%- endform -%}
  </product-form>
</div>

{% schema %}
{
  "name": "t:blocks.buy-buttons.name",
  "settings": [],
  "presets": [
    {
      "name": "t:blocks.buy-buttons.name"
    }
  ]
}
{% endschema %}
