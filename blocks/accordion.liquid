{%- comment -%}
  Accordion (docs/BUILD.md 6.6): a native details and summary pair, so it opens and
  closes with no script. Used on the product page for the exchange policy and garment care,
  which the guide requires to be reachable from the product.

  Content: a page from the page picker, or rich text. The page wins when it has content;
  otherwise the rich text is used. The heading is the summary text; with a page and no
  heading, the page title is used. With no heading, or with neither page content nor text,
  the block renders nothing.
{%- endcomment -%}

{%- liquid
  assign accordion_heading = block.settings.heading
  assign accordion_page = block.settings.page
  assign accordion_content = ''

  if accordion_page != blank
    assign accordion_content = accordion_page.content
    if accordion_heading == blank
      assign accordion_heading = accordion_page.title
    endif
  endif

  if accordion_content == blank
    assign accordion_content = block.settings.text
  endif
-%}

{%- if accordion_heading != blank and accordion_content != blank -%}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}

  <details class="accordion" {{ block.shopify_attributes }}>
    <summary class="accordion__summary text-body">
      <span class="accordion__heading">{{ accordion_heading }}</span>
      {% render 'icon', name: 'chevron-down' %}
    </summary>
    <div class="accordion__content text-body">{{ accordion_content }}</div>
  </details>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.accordion.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.accordion.settings.heading.label"
    },
    {
      "type": "page",
      "id": "page",
      "label": "t:blocks.accordion.settings.page.label",
      "info": "t:blocks.accordion.settings.page.info"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:blocks.accordion.settings.text.label",
      "info": "t:blocks.accordion.settings.text.info"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.accordion.name"
    }
  ]
}
{% endschema %}
