{%- liquid
  # Direction comes from the request locale's language. Liquid exposes no
  # direction property, so the right-to-left languages are listed here.
  assign locale_language = request.locale.iso_code | split: '-' | first
  assign rtl_languages = 'ar,he,fa,ur,ps,sd,ug,yi,dv,ckb' | split: ','
  assign text_direction = 'ltr'
  if rtl_languages contains locale_language
    assign text_direction = 'rtl'
  endif
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ text_direction }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {%- comment -%}
      Minimal title only. snippets/meta-tags.liquid (description, canonical,
      Open Graph, structured data) arrives in F3; no other meta tags before then.
    {%- endcomment -%}
    <title>{{ page_title | escape }}</title>

    {% render 'head-assets' %}

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>

    {%- comment -%}
      Single polite live region for cart and error announcements. It must stay
      in the DOM from first load; scripts only change its text, through
      Mares.announce in assets/core.js.
    {%- endcomment -%}
    <div id="live-region" class="visually-hidden" aria-live="polite" aria-atomic="true"></div>

    {%- comment -%}
      Routes for assets/core.js, as data (type application/json is never executed).
      Liquid routes carry the locale prefix, so scripts never hard-code /cart.
    {%- endcomment -%}
    <script type="application/json" id="mares-routes">
      {
        "root": {{ routes.root_url | json }},
        "cart": {{ routes.cart_url | json }},
        "cartAdd": {{ routes.cart_add_url | json }},
        "cartChange": {{ routes.cart_change_url | json }},
        "cartUpdate": {{ routes.cart_update_url | json }}
      }
    </script>

    {% sections 'header-group' %}

    <main id="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- comment -%}
      No script tags here. core.js is loaded by sections/header.liquid (the first section
      on every page, so it runs before every other deferred script); each section loads
      only the scripts it uses.
    {%- endcomment -%}
  </body>
</html>
